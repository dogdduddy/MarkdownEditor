{
  "manifest_version": 3,
  "name": "MD Lens",
  "version": "1.0.0",
  "description": "Markdown 파일을 브라우저에서 보기 좋게 렌더링합니다. 목차, 폴더 탐색, 테마, 플러그인 지원.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "MD Lens",
    "default_popup": "options.html?popup=1"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "file:///*",
        "*://*/*.md",
        "*://*/*.md?*",
        "*://*/*.markdown",
        "*://*/*.markdown?*",
        "*://*/*.mdown",
        "*://*/*.mkd"
      ],
      "js": [
        "loader.js"
      ],
      "run_at": "document_end"
    }
  ]
}
